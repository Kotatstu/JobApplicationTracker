@backend_HostAddress = http://localhost:5083

//====================================================================== COMPANY ====================================================================

GET {{backend_HostAddress}}/api/companies/getAll/00000000-0000-0000-0000-000000000001
Content-Type: application/json

###Get by id
GET {{backend_HostAddress}}/api/companies/getById/4/00000000-0000-0000-0000-000000000001
Content-Type: application/json

### create a new company
POST {{backend_HostAddress}}/api/companies/create/00000000-0000-0000-0000-000000000001
Content-Type: application/json

{
  "CompanyName": "createATAction fix test",
  "WebsiteUrl": "Test.com",
  "Industry": "Logistic"
}

###Update a company
PUT {{backend_HostAddress}}/api/companies/update/6/00000000-0000-0000-0000-000000000001
Content-Type: application/json

{
  "CompanyName": "UserId tested",
  "WebsiteUrl": "Ichangetheurl.com",
  "Industry": ""
}

